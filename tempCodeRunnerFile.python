import random
import os
import time

class CodeBreaker:
    def __init__(self):
        self.level = 1
        self.score = 0
        self.max_level = 5
        
    def clear_screen(self):
        os.system('cls' if os.name == 'nt' else 'clear')
        
    def display_header(self):
        print("=" * 50)
        print("       CODE BREAKER: CYBER INTRUSION")
        print("=" * 50)
        print(f"Level: {self.level} | Score: {self.score}")
        print("-" * 50)
        
    def generate_code(self, length, use_letters=False, use_symbols=False):
        """Generate a random code based on level parameters"""
        digits = [str(i) for i in range(10)]
        letters = [chr(i) for i in range(65, 91)]  # A-Z
        symbols = ['!', '@', '#', '$', '%', '&', '*']
        
        pool = digits
        if use_letters:
            pool += letters
        if use_symbols:
            pool += symbols
            
        return ''.join(random.choices(pool, k=length))
    
    def get_hint(self, code, revealed_count):
        """Reveal part of the code as a hint"""
        if revealed_count >= len(code):
            return code
            
        positions = random.sample(range(len(code)), revealed_count)
        hint = ['_' if i not in positions else code[i] for i in range(len(code))]
        return ''.join(hint)
    
    def calculate_points(self, attempts, max_attempts, level):
        """Calculate points based on performance"""
        base_points = level * 100
        efficiency_bonus = (max_attempts - attempts) * 20
        return base_points + efficiency_bonus
    
    def level_1(self):
        """Basic number code"""
        code_length = 4
        max_attempts = 10
        code = self.generate_code(code_length)
        
        print("LEVEL 1: NUMBER SEQUENCE")
        print("Crack the 4-digit numeric code!")
        print(f"You have {max_attempts} attempts.")
        print()
        
        for attempt in range(1, max_attempts + 1):
            guess = input(f"Attempt {attempt}/{max_attempts}: ").strip()
            
            if len(guess) != code_length or not guess.isdigit():
                print("Invalid input! Enter exactly 4 digits.")
                continue
                
            if guess == code:
                points = self.calculate_points(attempt, max_attempts, self.level)
                self.score += points
                print(f"✓ ACCESS GRANTED! Code: {code}")
                print(f"✓ Points earned: {points}")
                time.sleep(2)
                return True
            else:
                # Give feedback
                correct_positions = sum(1 for i in range(code_length) if guess[i] == code[i])
                print(f"✗ Incorrect! {correct_positions} digit(s) in correct position.")
                
                # Offer hint after 3 failed attempts
                if attempt == 3:
                    hint = self.get_hint(code, 1)
                    print(f"💡 Hint: {hint}")
        
        print(f"✗ INTRUSION DETECTED! System locked.")
        print(f"The code was: {code}")
        time.sleep(3)
        return False
    
    def level_2(self):
        """Longer code with positional feedback"""
        code_length = 5
        max_attempts = 8
        code = self.generate_code(code_length)
        
        print("LEVEL 2: ENHANCED SECURITY")
        print("Crack the 5-digit code!")
        print(f"You have {max_attempts} attempts.")
        print()
        
        for attempt in range(1, max_attempts + 1):
            guess = input(f"Attempt {attempt}/{max_attempts}: ").strip()
            
            if len(guess) != code_length or not guess.isdigit():
                print("Invalid input! Enter exactly 5 digits.")
                continue
                
            if guess == code:
                points = self.calculate_points(attempt, max_attempts, self.level)
                self.score += points
                print(f"✓ ACCESS GRANTED! Code: {code}")
                print(f"✓ Points earned: {points}")
                time.sleep(2)
                return True
            else:
                # Detailed feedback
                correct_positions = sum(1 for i in range(code_length) if guess[i] == code[i])
                correct_digits = sum(min(guess.count(d), code.count(d)) for d in set(guess))
                correct_digits = min(correct_digits, code_length)  # Cap at code length
                
                print(f"✗ {correct_positions} correct position(s), {correct_digits} correct digit(s) total")
                
                if attempt == 2:
                    hint = self.get_hint(code, 2)
                    print(f"💡 Hint: {hint}")
        
        print(f"✗ INTRUSION DETECTED! System locked.")
        print(f"The code was: {code}")
        time.sleep(3)
        return False
    
    def level_3(self):
        """Alphanumeric code"""
        code_length = 4
        max_attempts = 8
        code = self.generate_code(code_length, use_letters=True)
        
        print("LEVEL 3: ALPHANUMERIC CIPHER")
        print("Crack the 4-character code (letters and numbers)!")
        print("Letters are CASE SENSITIVE.")
        print(f"You have {max_attempts} attempts.")
        print()
        
        for attempt in range(1, max_attempts + 1):
            guess = input(f"Attempt {attempt}/{max_attempts}: ").strip().upper()
            
            if len(guess) != code_length:
                print(f"Invalid input! Enter exactly {code_length} characters.")
                continue
                
            if guess == code:
                points = self.calculate_points(attempt, max_attempts, self.level)
                self.score += points
                print(f"✓ ACCESS GRANTED! Code: {code}")
                print(f"✓ Points earned: {points}")
                time.sleep(2)
                return True
            else:
                correct_positions = sum(1 for i in range(code_length) if guess[i] == code[i])
                print(f"✗ {correct_positions} character(s) in correct position")
                
                if attempt == 3:
                    # Tell them how many are letters vs numbers
                    letters_in_code = sum(1 for c in code if c.isalpha())
                    numbers_in_code = code_length - letters_in_code
                    print(f"💡 The code contains {letters_in_code} letter(s) and {numbers_in_code} number(s)")
        
        print(f"✗ INTRUSION DETECTED! System locked.")
        print(f"The code was: {code}")
        time.sleep(3)
        return False
    
    def level_4(self):
        """Memory challenge"""
        code_length = 6
        max_attempts = 5
        code = self.generate_code(code_length, use_letters=True)
        
        print("LEVEL 4: MEMORY CHALLENGE")
        print("Memorize the code shown briefly!")
        print(f"You have {max_attempts} attempts.")
        print()
        
        print("Code revealed in 3...")
        time.sleep(1)
        print("2...")
        time.sleep(1)
        print("1...")
        time.sleep(1)
        
        print(f"CODE: {code}")
        time.sleep(2)  # Show code for 2 seconds
        
        self.clear_screen()
        self.display_header()
        print("LEVEL 4: MEMORY CHALLENGE")
        print("Enter the code you just saw!")
        
        for attempt in range(1, max_attempts + 1):
            guess = input(f"Attempt {attempt}/{max_attempts}: ").strip().upper()
            
            if len(guess) != code_length:
                print(f"Invalid input! Enter exactly {code_length} characters.")
                continue
                
            if guess == code:
                points = self.calculate_points(attempt, max_attempts, self.level)
                self.score += points
                print(f"✓ ACCESS GRANTED! Code: {code}")
                print(f"✓ Points earned: {points}")
                time.sleep(2)
                return True
            else:
                correct_positions = sum(1 for i in range(code_length) if guess[i] == code[i])
                print(f"✗ {correct_positions} character(s) correct")
                
                if attempt == 2:
                    hint = self.get_hint(code, 3)
                    print(f"💡 Hint: {hint}")
        
        print(f"✗ INTRUSION DETECTED! System locked.")
        print(f"The code was: {code}")
        time.sleep(3)
        return False
    
    def level_5(self):
        """Final challenge with symbols"""
        code_length = 6
        max_attempts = 6
        code = self.generate_code(code_length, use_letters=True, use_symbols=True)
        
        print("LEVEL 5: MASTER CIPHER")
        print("Crack the 6-character code (letters, numbers, AND symbols)!")
        print("Example symbols: ! @ # $ % & *")
        print(f"You have {max_attempts} attempts.")
        print()
        
        for attempt in range(1, max_attempts + 1):
            guess = input(f"Attempt {attempt}/{max_attempts}: ").strip().upper()
            
            if len(guess) != code_length:
                print(f"Invalid input! Enter exactly {code_length} characters.")
                continue
                
            if guess == code:
                points = self.calculate_points(attempt, max_attempts, self.level)
                self.score += points
                print(f"✓ ACCESS GRANTED! Code: {code}")
                print(f"✓ Points earned: {points}")
                time.sleep(2)
                return True
            else:
                correct_positions = sum(1 for i in range(code_length) if guess[i] == code[i])
                print(f"✗ {correct_positions} character(s) in correct position")
                
                if attempt == 2:
                    # Count character types
                    letters = sum(1 for c in code if c.isalpha())
                    numbers = sum(1 for c in code if c.isdigit())
                    symbols = code_length - letters - numbers
                    print(f"💡 The code contains {letters} letter(s), {numbers} number(s), {symbols} symbol(s)")
        
        print(f"✗ INTRUSION DETECTED! System locked.")
        print(f"The code was: {code}")
        time.sleep(3)
        return False
    
    def play(self):
        self.clear_screen()
        self.display_header()
        
        print("Welcome, Agent. Your mission:")
        print("Breach the secure systems by cracking their codes.")
        print("Each level increases in difficulty.")
        print("Good luck!")
        print()
        input("Press Enter to begin...")
        
        levels = [self.level_1, self.level_2, self.level_3, self.level_4, self.level_5]
        
        for level_func in levels:
            self.clear_screen()
            self.display_header()
            
            success = level_func()
            if not success:
                print()
                print("MISSION FAILED")
                break
                
            self.level += 1
            if self.level > self.max_level:
                break
                
            # Brief pause before next level
            self.clear_screen()
            self.display_header()
            print("Preparing next system...")
            time.sleep(2)
        
        # Game over
        self.clear_screen()
        self.display_header()
        if self.level > self.max_level:
            print("🎉 CONGRATULATIONS! YOU MASTERED ALL SYSTEMS!")
        else:
            print(f"Game Over! You reached Level {self.level-1}")
        
        print(f"Final Score: {self.score}")
        print()
        print("Thanks for playing Code Breaker!")
        
        # Score evaluation
        if self.score >= 2000:
            rating = "ELITE HACKER"
        elif self.score >= 1500:
            rating = "SECURITY EXPERT"
        elif self.score >= 1000:
            rating = "SKILLED AGENT"
        elif self.score >= 500:
            rating = "JUNIOR AGENT"
        else:
            rating = "NOVICE"
            
        print(f"Rank: {rating}")

if __name__ == "__main__":
    game = CodeBreaker()
    game.play()